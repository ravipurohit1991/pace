<?xml version="1.0" encoding="utf-8"?>
<!--
  A real Chronometer, embedded in the Glance tree via AndroidRemoteViews.

  Glance renders only when something asks it to, so a countdown computed in Kotlin freezes between
  refreshes. Chronometer is ticked by the system itself, with no app process involved, so this stays
  live on the home screen indefinitely.
-->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_countdown"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textColor="#FFFFFFFF"
    android:textSize="17sp"
    android:textStyle="bold"
    android:maxLines="1"
    android:singleLine="true"
    android:ellipsize="none"
    android:includeFontPadding="false" />
