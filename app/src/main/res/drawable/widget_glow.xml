<?xml version="1.0" encoding="utf-8"?>
<!--
  A soft highlight behind the top-left of the widget, where the count sits.

  Radial rather than linear so the brightest point lands on the number itself: on a home screen the
  widget competes with wallpaper, and a little depth under the one figure that matters buys more
  legibility than raising the contrast of everything would.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:centerX="0.22"
        android:centerY="0.18"
        android:gradientRadius="70%p"
        android:startColor="#3DFFFFFF"
        android:endColor="#00FFFFFF" />
</shape>
